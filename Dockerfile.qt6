# syntax=docker/dockerfile:1
FROM ghcr.io/fstanis/pocketbook-sdk-qt6-builder@sha256:1878e90fd4c9b8e736cd49b61f79cbd6fba354f6c12686a3a7c35696f2e2eb06

# Native build tools/QML runtime support offscreen host tests; armel libraries
# build the device app. OpenSSL 3 replaces the legacy SDK crypto archive.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl python3 pkg-config ninja-build \
    libssl-dev:armel libcurl4-openssl-dev:armel libxml2-dev:armel \
    libsqlite3-dev:armel libjson-c-dev:armel \
    qt6-base-dev qt6-declarative-dev \
    libssl-dev libcurl4-openssl-dev libxml2-dev libsqlite3-dev libjson-c-dev \
    qml6-module-qtquick qml6-module-qtquick-window qml6-module-qtqml-workerscript \
    && rm -rf /var/lib/apt/lists/*

# Pin the upstream CMake helpers and the exact SDK submodule revision they use.
# Fetch only their four required SDK files rather than a multi-gigabyte checkout.
RUN git clone https://github.com/fstanis/pocketbook-sdk-qt6.git /opt/pocketbook-sdk-qt6 \
    && git -C /opt/pocketbook-sdk-qt6 checkout 754e436c7c24b4e2695154e2efffbf7447b4130e \
    && sdk=/opt/pocketbook-sdk-qt6/sdk/SDK-B288/usr/arm-obreey-linux-gnueabi/sysroot/usr/local \
    && mkdir -p "$sdk/include" "$sdk/lib" \
    && for file in include/inkview.h include/hwconfig.h lib/libinkview.so lib/libhwconfig.so; do \
        curl -fL --retry 3 "https://raw.githubusercontent.com/pocketbook/SDK_6.3.0/dd8de463733a2bc0d53d1214b64734586fac427e/SDK-B288/usr/arm-obreey-linux-gnueabi/sysroot/usr/local/$file" -o "$sdk/$file"; \
       done
ENV POCKETBOOK_QT_SDK=/opt/pocketbook-sdk-qt6
WORKDIR /workspace
CMD ["make"]

# Firmware libcurl has unversioned exports; Debian's CURL_OPENSSL_4 link ABI does
# not match. Use the pinned SDK library only at link time, with modern headers.
# HTTPS still executes the reader's libcurl.so.4; no curl library is shipped.
RUN curl -fL --retry 3 \
    https://raw.githubusercontent.com/pocketbook/SDK_6.3.0/dd8de463733a2bc0d53d1214b64734586fac427e/SDK-B288/usr/arm-obreey-linux-gnueabi/sysroot/usr/lib/libcurl.so.4.6.0 \
    -o /opt/pocketbook-sdk-qt6/libcurl.so.4
